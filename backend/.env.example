PORT=3000
MONGODB_URI=mongodb://localhost:27017/comicsweb

# Better Auth
# Clave para firmar las sesiones: generar una con `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=
# URL del frontend (el frontend reenvía /api al backend). En Render: la URL del Static Site
BETTER_AUTH_URL=http://localhost:5173

# OAuth App de GitHub (https://github.com/settings/developers)
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cliente OAuth de Google (https://console.cloud.google.com/apis/credentials), tipo "Aplicación web"
# URI de redireccionamiento: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
